# The Studio and generation service run on the same host by default.
GRAVITY_HOST=127.0.0.1
GRAVITY_PORT=7331
GRAVITY_SERVER_URL=http://127.0.0.1:7331
GRAVITY_STUDIO_PORT=4321
GRAVITY_STUDIO_HOST=127.0.0.1
GRAVITY_DATA_DIR=./storage
# Set the exact browser origins allowed to use the API when accessing over LAN.
GRAVITY_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
